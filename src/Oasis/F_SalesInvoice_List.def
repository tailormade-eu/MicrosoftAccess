CodeBehindForm
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Compare Database
Option Explicit

Private Sub cmdNew_Click()
    DoCmd.OpenForm "SalesInvoice_Edit", datamode:=acFormAdd, windowMode:=acDialog
    Form_Search
End Sub

Private Sub cmdPrint_Click()
Dim invoiceSuffix As String
    If Me.subSearch.Form.CurrentRecord > 0 Then
        invoiceSuffix = Nz(Me.subSearch.Form.ProductTypeInvoiceSuffix, "")
        
        DoCmd.OpenReport "SalesInvoice_Print" & IIf(Len(invoiceSuffix) > 0, "_" & invoiceSuffix, ""), acViewReport, , "Id=" & Me.subSearch.Form.Id
    End If
End Sub

Private Sub txtSearch_AfterUpdate()
    Form_Search
End Sub


Private Sub Form_Search()
    Me.subSearch.Requery
End Sub

Private Sub cmdClearSearch_Click()
    Me.txtSearch = Null
    Form_Search
End Sub
