Private Sub PageHeaderSection_Format(Cancel As Integer, FormatCount As Integer)
    Me.boxCompany.BackColor = HexToAccessColor(Color1)
    Me.boxHeader.BackColor = HexToAccessColor(Color2)
    Me.boxAmount.BackColor = HexToAccessColor(Color2)
    Me.subLines.Report.Section("Detail").AlternateBackColor = HexToAccessColor(Color1)
    Me.InvoiceMemo.visible = Not omStringFunctions.IsNullOrEmpty(Me.InvoiceMemo)
    Me.ReferalInvoiceNumber.visible = Not omStringFunctions.IsNullOrEmpty(Me.ReferalInvoiceNumber)
End Sub

Private Sub Report_Current()
    If Me.Surcharge2 = 0 Then
        Me.lblExtraCharge.visible = False
        Me.txtExtraCharge.visible = False
    Else
        Me.lblExtraCharge.visible = True
        Me.txtExtraCharge.visible = True
        If Me.Surcharge2CalculationTypeId = 6 Then
            Me.lblExtraCharge.Caption = Me.Surcharge2Name & " (" & [txtTotalQuantity] & "/100x" & Format([Surcharge2], "0.00") & ")"
            Me.txtExtraCharge.ControlSource = "=[txtTotalQuantity]/100*[Surcharge2]"
        Else
            Me.lblExtraCharge.Caption = "ExtraCharge"
            Me.txtExtraCharge.ControlSource = ""
        End If
    End If
End Sub

