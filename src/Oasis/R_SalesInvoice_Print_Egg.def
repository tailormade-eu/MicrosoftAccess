Function HexToAccessColor(hexColor As String) As Long
    Dim r As Integer, g As Integer, b As Integer
    
    ' Strip leading # if present
    If Left(hexColor, 1) = "#" Then hexColor = Mid(hexColor, 2)
    
    ' Extract components
    r = CInt("&H" & Mid(hexColor, 1, 2))
    g = CInt("&H" & Mid(hexColor, 3, 2))
    b = CInt("&H" & Mid(hexColor, 5, 2))
    
    ' Return as Access BackColor
    HexToAccessColor = RGB(r, g, b)
End Function

Private Sub ReportFooter_Format(Cancel As Integer, FormatCount As Integer)
Dim sVisible As Boolean
    sVisible = Nz(Me.Surcharge1, 0) <> 0
    Me.Surcharge1Name.visible = sVisible
    Me.Surcharge1.visible = sVisible
    Me.Surcharge1CalculationTypeCode.visible = sVisible
    sVisible = Nz(Me.Surcharge2, 0) <> 0
    Me.Surcharge2Name.visible = sVisible
    Me.Surcharge2.visible = sVisible
    Me.Surcharge2CalculationTypeCode.visible = sVisible
End Sub
