Private Sub PageHeaderSection_Format(Cancel As Integer, FormatCount As Integer)
    Me.boxCompany.BackColor = HexToAccessColor(Color1)
    Me.boxHeader.BackColor = HexToAccessColor(Color2)
    Me.subLines.Report.Section("Detail").AlternateBackColor = HexToAccessColor(Color1)
    Me.InvoiceMemo.visible = Not omStringFunctions.IsNullOrEmpty(Me.InvoiceMemo)
    Me.ReferalInvoiceNumber.visible = Not omStringFunctions.IsNullOrEmpty(Me.ReferalInvoiceNumber)
End Sub

